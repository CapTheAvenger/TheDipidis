// Firestore Security Rules — TheDipidis
//
// SINGLE SOURCE OF TRUTH for the Firestore security model.
//
// FIRESTORE_RULES.md is documentation: it walks through the model
// (collections, roles, deploy steps) and embeds a copy of this file
// for readability. If you change rules here, regenerate or hand-edit
// the snippet in FIRESTORE_RULES.md to match.
//
// Deploy path (manual):
//   1. Copy the contents of this file
//   2. Firebase Console → Firestore Database → Rules → paste → Publish
// There is no `firebase deploy` automation in CI today. Adding one
// would be:
//   - commit a firebase.json with `firestore.rules` pointed at this file
//   - a workflow that runs `firebase deploy --only firestore:rules`
//     against a service-account secret on push-to-main affecting
//     this file
//
// Reconciled with Live on 2026-06-12 (AUDIT_GITHUB.md F-24). Before
// that the file was the 65-LOC 2026-03 legacy version and live had
// drifted ~100 LOC ahead via Console hand-edits.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────
    // Users' own data (Battle Journal, Decks, Collection, etc.)
    // ─────────────────────────────────────────────────────────
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────────────────
    // Shared decks — the ?sharedDeck=<id> short links produced by
    // js/app-features.js:1065 (.set()) and read back at :1119 (.get()).
    //
    // This collection had NO rule at all, so both calls hit the default deny.
    // Either deck sharing has been quietly broken since it shipped, or live
    // was hand-edited in the Console and this file drifted again — the exact
    // failure the header above records for 2026-06-12. Writing the rule down
    // makes the answer observable either way.
    //
    // read is open on purpose: the link IS the capability, and the recipient
    // is usually not signed in — that is what a share link is for. The payload
    // is a public decklist, no user data. Note the id is only 6 chars from a
    // 55-char alphabet (~1e10) and drawn with Math.random(), so treat these as
    // unguessable-enough-for-decklists, not as secrets.
    //
    // create is open to match: sharing works without an account today, same as
    // the rest of the deck builder. It is bounded instead — one write, capped
    // size, required shape — so an open endpoint can't be used as free storage.
    // update and delete are denied outright: a link, once handed out, must not
    // change under the recipient.
    match /shared_decks/{shareId} {
      allow read: if true;
      allow create: if shareId.size() <= 24
        && request.resource.data.keys().hasOnly(['deck', 'order', 'archetype', 'source', 'timestamp'])
        && request.resource.data.deck is map
        && request.resource.data.deck.size() <= 120;
        // No byte cap here: .size() on a map counts keys, not bytes, so a
        // "< 200000" clause would read like a size limit and enforce nothing.
        // The 120-entry deck cap is the real bound (a legal deck is 60 cards);
        // Firestore's own 1 MiB document limit backs it up.
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Public profile — uid → Anzeigename. NUR get, NIE list.
    //
    // Die alte Regel lautete `allow read: if request.auth != null`. `read`
    // umfasst `get` UND `list`, und `list` gilt fuer die ganze Collection:
    // gemessen am 21.08.2026 gegen die Produktivdatenbank lieferte ein
    // einziges db.collection('publicProfiles').get() jedem eingeloggten
    // Nutzer alle 5 Konten samt vollstaendiger E-Mail-Adresse — zwei davon
    // fremde Adressen. Das war ein echter Datenabfluss, kein Design-Kompromiss.
    //
    // `list` ist hier auch nicht noetig: seit dem Hash-Index (unten) schlaegt
    // Testing Groups eine E-Mail per direktem get() nach, nicht per Query.
    // Die Klartext-E-Mail faellt zugleich ganz aus dieser Collection —
    // _ensurePublicProfile() loescht sie beim naechsten Login des jeweiligen
    // Nutzers aus dessen eigenem Dokument.
    //
    // `allow list: if false` steht ausdruecklich da, statt nur weggelassen zu
    // werden: eine fehlende Regel liest sich wie ein Versehen, eine
    // ausgeschriebene Verweigerung wie eine Entscheidung.
    // ─────────────────────────────────────────────────────────
    match /publicProfiles/{uid} {
      allow get:   if request.auth != null;
      allow list:  if false;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────────────────
    // E-Mail-Index — SHA-256(kleingeschriebene E-Mail) → { uid }.
    //
    // Ersetzt die Query `.where('email','==',...)`, die zwingend `list`
    // brauchte. Die Dokument-ID IST der Suchschluessel, also genuegt get():
    // wer die E-Mail kennt, findet den Nutzer; wer sie nicht kennt, kann
    // nichts aufzaehlen. In der Datenbank steht kein Klartext mehr.
    //
    // Die Schreibregel bindet den Hash an den angemeldeten Nutzer selbst
    // (hashing.sha256 ueber request.auth.token.email), damit niemand den Hash
    // einer fremden E-Mail auf die eigene uid zeigen lassen kann — sonst
    // koennte ein Angreifer sich beim Einladen an fremder Stelle einsetzen.
    // hasOnly(['uid']) haelt das Dokument auf genau ein Feld.
    // ─────────────────────────────────────────────────────────
    match /emailIndex/{emailHash} {
      allow get:  if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.token.email != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && emailHash ==
             hashing.sha256(request.auth.token.email.lower()).toHexString().lower();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Testing Group Invites — one invite doc per group, world-readable
    // by authenticated users so a non-member clicking a shared link
    // can validate the token before attempting to join.
    // Only the group owner can create/update/delete.
    // ─────────────────────────────────────────────────────────
    match /testingGroupInvites/{groupId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/testingGroups/$(groupId))
             .data.ownerUid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────
    // Testing Groups — collaborative matchup tables
    // ─────────────────────────────────────────────────────────
    match /testingGroups/{groupId} {

      // Helpers
      function isMember() {
        return request.auth != null
          && resource.data.memberUids.hasAny([request.auth.uid]);
      }
      function isOwner() {
        return request.auth != null
          && resource.data.ownerUid == request.auth.uid;
      }
      function roleIs(role) {
        return request.auth != null
          && resource.data.members[request.auth.uid].role == role;
      }

      // Members can read the group.
      allow read: if isMember();

      // Any signed-in user can create a group IF the new doc lists
      // them as the sole owner + member.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members[request.auth.uid].role == 'owner';

      // Owner: full update / delete.
      // Editor: can only modify the 'data' field + 'updatedAt'.
      // Viewer: cannot write.
      // Non-members must go through the /joinRequests subcollection
      // now — owners approve/deny there and then update the group.
      allow update: if
        (isOwner()) ||
        (
          roleIs('editor') &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['data', 'updatedAt'])
        );

      allow delete: if isOwner();

      // Activity log — any member can append, nobody can modify.
      match /activity/{activityId} {
        allow read:   if request.auth != null
          && get(/databases/$(database)/documents/testingGroups/$(groupId))
               .data.memberUids.hasAny([request.auth.uid]);
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/testingGroups/$(groupId))
               .data.memberUids.hasAny([request.auth.uid])
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }

      // Join requests — created by non-members via invite link, read/
      // deleted by the group owner (approve = delete + group update,
      // deny = delete). Doc id = requesting user's uid so we get
      // unique-per-user for free.
      match /joinRequests/{uid} {
        // Requester can create their own request IF a valid invite
        // exists for this group.
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && exists(/databases/$(database)/documents/testingGroupInvites/$(groupId));
        // Requester can read + delete (cancel) their own request.
        // Owner of the group can read + delete any request.
        allow read, delete: if request.auth != null && (
          request.auth.uid == uid ||
          get(/databases/$(database)/documents/testingGroups/$(groupId))
               .data.ownerUid == request.auth.uid
        );
        allow update: if false;
      }
    }
  }
}
