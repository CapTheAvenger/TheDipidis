rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS (DRY)
    // ══════════════════════════════════════════════════════════════════════

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidSize(maxBytes) {
      return request.resource.size < maxBytes;
    }

    // ══════════════════════════════════════════════════════════════════════
    // MULTIPLAYER PLAYTESTER GAMES
    // ══════════════════════════════════════════════════════════════════════
    
    match /games/{gameId} {
      
      // ✅ CREATE: Jeder eingeloggte User kann ein Spiel erstellen
      allow create: if request.auth != null 
        && request.resource.data.host == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.keys().hasAll(['host', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['roomCode', 'host', 'hostName', 'guest', 'guestName', 'state', 'status', 'createdAt', 'lastAction', '_syncVersion', 'lastActionDescription', 'lastActionBy', 'format', 'settings'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.size() < 50;
      
      // ✅ READ: Nur Host & Guest dürfen das Spiel lesen
      allow read: if request.auth != null 
        && (request.auth.uid == resource.data.host 
            || request.auth.uid == resource.data.guest);
      
      // ✅ UPDATE: Nur Host & Guest dürfen updaten
      allow update: if request.auth != null 
        && (request.auth.uid == resource.data.host 
            || request.auth.uid == resource.data.guest
            // Guest-Join: Nur wenn noch kein Guest & der Schreiber sich selbst einträgt
            || (resource.data.guest == null 
                && request.resource.data.guest == request.auth.uid))
        // Verhindere, dass Host geändert wird
        && request.resource.data.host == resource.data.host
        // Guest darf nur von null -> eigene UID gesetzt werden, danach unveränderlich
        && (request.resource.data.guest == resource.data.guest 
            || (resource.data.guest == null 
                && request.resource.data.guest == request.auth.uid))
        // createdAt darf nicht verändert werden
        && request.resource.data.createdAt == resource.data.createdAt
        // Nur erlaubte Felder
        && request.resource.data.keys().hasOnly(['roomCode', 'host', 'hostName', 'guest', 'guestName', 'state', 'status', 'createdAt', 'lastAction', '_syncVersion', 'lastActionDescription', 'lastActionBy', 'endedAt', 'lastCoinFlip', 'format', 'settings'])
        // Write-Rate-Limit: min 500ms zwischen Updates + Client muss lastAction setzen
        && request.resource.data.lastAction == request.time
        && (!('lastAction' in resource.data) 
            || request.time > resource.data.lastAction + duration.value(500, 'ms'))
        && request.resource.data.size() < 50;
      
      // ✅ DELETE: Nur Host darf löschen
      allow delete: if request.auth != null 
        && request.auth.uid == resource.data.host;
    }
    
    // ══════════════════════════════════════════════════════════════════════
    // USER COLLECTIONS (bereits vorhanden - nicht überschreiben!)
    // ══════════════════════════════════════════════════════════════════════

    // displayName whitelist (B-2 hardening): keep server enforcement aligned
    // with the client-side check in firebase-collection.saveDisplayName().
    function isValidDisplayName(name) {
      return name is string
        && name.size() >= 1
        && name.size() <= 40
        && name.matches('^[A-Za-z0-9 _\\-.,!?\']+$');
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && isValidSize(1048576)
        && (!('displayName' in request.resource.data)
            || isValidDisplayName(request.resource.data.displayName));
    }
    
    match /users/{userId}/decks/{deckId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidSize(524288); // 512KB max
    }
    
    match /users/{userId}/favorites/{favoriteId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidSize(524288);
    }

    // ══════════════════════════════════════════════════════════════════════
    // USER PROFILES, COLLECTIONS & WISHLISTS
    // ══════════════════════════════════════════════════════════════════════

    match /profiles/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidSize(524288);
    }

    match /collections/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidSize(1048576);
    }

    match /wishlists/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidSize(1048576);
    }

    // ══════════════════════════════════════════════════════════════════════
    // FEATURE COLLECTIONS — added in B-33 hotfix.
    //
    // The audit found that production JS reads/writes the four collections
    // below but this repo file had no `match` blocks for them. With
    // rules_version='2' the default is deny, so either (a) the features
    // were silently failing or (b) the Firebase Console rules diverge from
    // this file and are more permissive.
    //
    // ACTION REQUIRED before pushing to production:
    //   1. Open Firebase Console → Firestore → Rules and compare with this file.
    //   2. If Console allows broader access (read-all, public list, etc.),
    //      either tighten Console to match this repo, or relax this repo to
    //      match Console — but document the choice.
    //   3. After alignment, deploy from this single source-of-truth file.
    //
    // The rules below are the SAFE-MINIMUM that should let the current
    // features keep working without exposing private data.
    // ══════════════════════════════════════════════════════════════════════

    // /shared_decks/{shareId} — anonymous-readable deck snapshots created from
    // the "Share Deck" flow. Read is open (the share URL contains the random
    // shareId so the doc is unguessable); write/delete only by the original
    // author.
    match /shared_decks/{shareId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && isValidSize(524288);
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // /publicProfiles/{userId} — opt-in public-facing profile (display name,
    // avatar). Owner writes, anyone can read.
    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId)
        && isValidSize(65536)
        && (!('displayName' in request.resource.data)
            || isValidDisplayName(request.resource.data.displayName));
    }

    // /testingGroups/{groupId} — multi-user testing groups (see app-testing-groups.js).
    // Members can read, only members can update game-state.
    match /testingGroups/{groupId} {
      function isMember() {
        return request.auth != null
          && request.auth.uid in resource.data.memberUids;
      }
      function becomesMember() {
        return request.auth != null
          && request.auth.uid in request.resource.data.memberUids;
      }
      allow read: if isMember();
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && becomesMember()
        && isValidSize(524288);
      allow update: if isMember()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && isValidSize(524288);
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // Subcollections (joinRequests, activity) — only group members.
      match /joinRequests/{requestId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/testingGroups/$(groupId)).data.memberUids;
        allow create: if request.auth != null
          && request.resource.data.requesterUid == request.auth.uid;
        allow update, delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/testingGroups/$(groupId)).data.memberUids;
      }
      match /activity/{activityId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/testingGroups/$(groupId)).data.memberUids;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/testingGroups/$(groupId)).data.memberUids
          && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false; // activity log is append-only
      }
    }

    // /testingGroupInvites/{groupId} — invite tokens, shorter-lived. The
    // group owner writes them; invitees read via the token in the URL.
    match /testingGroupInvites/{groupId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && isValidSize(65536);
    }

    // ══════════════════════════════════════════════════════════════════════
    // PUBLIC READ FOR CARD DATA (Optional)
    // ══════════════════════════════════════════════════════════════════════

    // Falls du Card-Daten in Firestore speicherst:
    // match /cards/{cardId} {
    //   allow read: if true;  // Public read
    //   allow write: if false; // Nur Admin
    // }
  }
}
