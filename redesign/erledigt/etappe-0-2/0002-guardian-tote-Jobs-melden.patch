+    def age_of(fn):
         p = os.path.join(DATA, fn)
         if not os.path.exists(p):
-            findings.append(("WARN", f"input missing: data/{fn}"))
-            continue
+            findings.append(("CRITICAL", f"input missing: data/{fn}"))
