                     <button id="battleJournalFab" class="header-icon-btn header-journal-btn" type="button" onclick="openBattleJournalSheet()" title="Battle Journal" aria-label="Battle Journal" data-i18n-title="bj.openShort" data-i18n-aria="bj.openShort">
